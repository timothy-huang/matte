TAVILY_API_KEY=
DAYTONA_API_KEY=
# Optional: DAYTONA_API_URL=https://app.daytona.io/api

# Model server (Ollama on a Nosana GPU node). Ollama's OpenAI-compatible API lives at /v1.
MODEL_BASE_URL=https://YOUR-NODE.node.k8s.prd.nos.ci/v1
MODEL_NAME=qwen3.8:27b
MODEL_API_KEY=ollama
# direct = app calls the model with tools; codeaf = CodeAF harness proposes the rule; off = prewritten rule
MODEL_PATH=direct
# CodeAF model slug when MODEL_PATH=codeaf (whatever `codeaf models` lists for your provider)
CODEAF_MODEL=

# local = evaluator runs in a separate local process; daytona = runs in a Daytona sandbox
EVAL_RUNNER=daytona
PORT=5173
